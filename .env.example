# ---------------------------------------------------------------------------
# Quote form delivery (/api/quote)
# ---------------------------------------------------------------------------

# REQUIRED: Make.com webhook. Quote requests POST here as JSON.
# Copy the URL from the Make scenario's webhook module.
# Not committed to the repo on purpose — anyone holding this URL can post into
# your scenario. Set it here for local dev and in your host's env settings for
# production. Left unset, webhook delivery is disabled.
QUOTE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# OPTIONAL BACKUP: email via Resend.
# Strongly recommended. If the Make scenario is ever switched off or errors,
# the webhook returns a failure and the visitor sees an error instead of the
# lead going through. With this configured, email catches those submissions.
#
# 1. Create an account at https://resend.com
# 2. Verify brothersezmove.com as a sending domain (adds DNS records)
# 3. Create an API key and paste it below
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Where the backup email is delivered. Defaults to info@brothersezmove.com.
QUOTE_INBOX=info@brothersezmove.com

# The From address. The domain must be verified in Resend.
QUOTE_FROM=Brothers EZ Moving Website <noreply@brothersezmove.com>
